{
  "name": "railpravah",
  "version": "1.0.0",
  "description": "RailPravah - AI-Powered Automatic Block Planning for Train Operations on Indian Railways",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:all",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && vite build",
    "build:all": "tsc && cd frontend && vite build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix frontend install",
    "test": "tsx src/tests/verify-api.ts"
  },
  "keywords": [
    "railpravah",
    "indian-railways",
    "block-planning",
    "supabase",
    "gemini",
    "ai"
  ],
  "author": "RailPravah Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.48.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
